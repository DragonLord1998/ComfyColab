{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfycolab.dev/schemas/comfycolab-lock-v1.schema.json",
  "title": "ComfyColab Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "core",
    "comfyui",
    "packs",
    "dependencies",
    "patches",
    "environments",
    "runtime_env"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "core": {
      "$ref": "#/$defs/versionedGitIdentity"
    },
    "comfyui": {
      "$ref": "#/$defs/gitIdentity"
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lockedPack"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/lockedGitDependency"
          },
          {
            "$ref": "#/$defs/lockedHuggingFaceDependency"
          },
          {
            "$ref": "#/$defs/lockedArtifactDependency"
          }
        ]
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lockedPatch"
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lockedEnvironment"
      }
    },
    "runtime_env": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lockedRuntimeEnvironment"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "logicalName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^/@?#]+(?:\\.[^/@?#]+)+/[^?#]+$"
    },
    "gitUrl": {
      "type": "string",
      "pattern": "^https://[^/@?#]+(?:\\.[^/@?#]+)+/[^?#]+\\.git$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
    },
    "requestedBy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/httpsUrl"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "versionedGitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "repository",
        "commit"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "$ref": "#/$defs/httpsUrl"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "nodeRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "target": {
          "type": "string",
          "pattern": "^[^/\\\\]+$"
        }
      }
    },
    "lockedPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "repository",
        "commit",
        "manifest_sha256",
        "node_roots"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "$ref": "#/$defs/gitUrl"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "license_gate": {
          "$ref": "#/$defs/logicalName"
        },
        "node_roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeRoot"
          }
        }
      }
    },
    "installPhase": {
      "enum": [
        "bootstrap",
        "lazy"
      ]
    },
    "lockedGitDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "repository",
        "ref",
        "destination",
        "scope",
        "requested_by"
      ],
      "properties": {
        "kind": {
          "const": "git"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "repository": {
          "$ref": "#/$defs/gitUrl"
        },
        "ref": {
          "$ref": "#/$defs/commit"
        },
        "destination": {
          "$ref": "#/$defs/relativePath"
        },
        "scope": {
          "$ref": "#/$defs/logicalName"
        },
        "requirements_file": {
          "$ref": "#/$defs/relativePath"
        },
        "requirements_source": {
          "enum": [
            "dependency",
            "pack"
          ]
        },
        "requirements_format": {
          "enum": [
            "requirements.txt",
            "pyproject.toml",
            "comfycolab-environment-toml"
          ]
        },
        "install_phase": {
          "$ref": "#/$defs/installPhase"
        },
        "license_gate": {
          "$ref": "#/$defs/logicalName"
        },
        "requested_by": {
          "$ref": "#/$defs/requestedBy"
        }
      },
      "dependentRequired": {
        "requirements_source": [
          "requirements_file"
        ],
        "requirements_format": [
          "requirements_file"
        ]
      }
    },
    "huggingFaceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lockedHuggingFaceDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "repository",
        "ref",
        "destination",
        "scope",
        "requested_by"
      ],
      "properties": {
        "kind": {
          "const": "huggingface"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "ref": {
          "$ref": "#/$defs/commit"
        },
        "destination": {
          "$ref": "#/$defs/relativePath"
        },
        "scope": {
          "$ref": "#/$defs/logicalName"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/huggingFaceArtifact"
          }
        },
        "install_phase": {
          "$ref": "#/$defs/installPhase"
        },
        "license_gate": {
          "$ref": "#/$defs/logicalName"
        },
        "requested_by": {
          "$ref": "#/$defs/requestedBy"
        }
      }
    },
    "lockedArtifactDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "url",
        "sha256",
        "destination",
        "scope",
        "requested_by"
      ],
      "properties": {
        "kind": {
          "const": "artifact"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "destination": {
          "$ref": "#/$defs/relativePath"
        },
        "scope": {
          "$ref": "#/$defs/logicalName"
        },
        "install_phase": {
          "$ref": "#/$defs/installPhase"
        },
        "license_gate": {
          "$ref": "#/$defs/logicalName"
        },
        "requested_by": {
          "$ref": "#/$defs/requestedBy"
        }
      }
    },
    "patchFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "before_sha256",
        "after_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "before_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "after_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lockedPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "target_ref",
        "specification",
        "specification_sha256",
        "order",
        "composition",
        "files",
        "requested_by"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "target_ref": {
          "$ref": "#/$defs/commit"
        },
        "specification": {
          "$ref": "#/$defs/relativePath"
        },
        "specification_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "composition": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/patchFile"
          }
        },
        "requested_by": {
          "$ref": "#/$defs/requestedBy"
        }
      }
    },
    "pythonRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "specifier",
        "requested_by"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "specifier": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "requested_by": {
          "$ref": "#/$defs/requestedBy"
        }
      },
      "dependentRequired": {
        "url": [
          "sha256"
        ],
        "sha256": [
          "url"
        ]
      }
    },
    "systemDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manager",
        "name",
        "scope",
        "requested_by"
      ],
      "properties": {
        "manager": {
          "enum": [
            "apt",
            "conda",
            "pixi",
            "binary"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "runtime",
            "environment"
          ]
        },
        "requested_by": {
          "$ref": "#/$defs/requestedBy"
        }
      }
    },
    "lockedEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "scope",
        "python_requirements",
        "system_dependencies",
        "requested_by"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "main",
            "isolated"
          ]
        },
        "scope": {
          "$ref": "#/$defs/logicalName"
        },
        "owner": {
          "$ref": "#/$defs/id"
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "cache_profile": {
          "$ref": "#/$defs/logicalName"
        },
        "license_gate": {
          "$ref": "#/$defs/logicalName"
        },
        "python_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pythonRequirement"
          }
        },
        "system_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/systemDependency"
          }
        },
        "requested_by": {
          "$ref": "#/$defs/requestedBy"
        }
      }
    },
    "lockedRuntimeEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "requested_by"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value": {
          "type": "string"
        },
        "requested_by": {
          "$ref": "#/$defs/requestedBy"
        }
      }
    }
  }
}
