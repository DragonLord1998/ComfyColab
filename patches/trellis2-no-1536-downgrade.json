      "replacements": [
        {
          "before_lines": [
            "    # Determine actual HR resolution (may reduce if too many tokens)",
            "    hr_resolution = hr_resolution_target",
            "    while True:",
            "        quant_coords = torch.cat([",
            "            hr_coords[:, :1],",
            "            ((hr_coords[:, 1:] + 0.5) / lr_resolution * (hr_resolution // 16)).int(),",
            "        ], dim=1)",
            "        final_coords = quant_coords.unique(dim=0)",
            "        num_tokens = final_coords.shape[0]",
            "        if num_tokens < max_num_tokens or hr_resolution == 1024:",
            "            if hr_resolution != hr_resolution_target:",
            "                log.info(f\"Resolution reduced to {hr_resolution} due to token limit\")",
            "            break",
            "        hr_resolution -= 128"
          ],
          "after_lines": [
            "    # Preserve the requested cascade resolution. Silent fallback makes the",
            "    # resulting asset impossible to identify and cache correctly.",
            "    hr_resolution = hr_resolution_target",
            "    quant_coords = torch.cat([",
            "        hr_coords[:, :1],",
            "        ((hr_coords[:, 1:] + 0.5) / lr_resolution * (hr_resolution // 16)).int(),",
            "    ], dim=1)",
            "    final_coords = quant_coords.unique(dim=0)",
            "    num_tokens = final_coords.shape[0]",
            "    if hr_resolution_target == 1536 and num_tokens >= max_num_tokens:",
            "        raise RuntimeError(",
            "            \"TRELLIS.2 1536_cascade needs \"",
            "            f\"{num_tokens} tokens, but max_tokens is {max_num_tokens}. \"",
            "            f\"Increase max_tokens to at least {num_tokens + 1}, or manually select \"",
            "            \"1024_cascade. ComfyColab did not downgrade this request.\"",
            "        )",
            "    log.info(f\"Strict cascade: {num_tokens} tokens at resolution {hr_resolution}\")"
          ]
        },
